<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 11 et moins (API 30-). Même exclusion que data_extraction_rules.xml.
   Le jeton Spotify est chiffré (EncryptedTokenStore) par une clé maître de l'Android Keystore, qui
   ne voyage pas avec une sauvegarde : le fichier restauré serait illisible, autant ne pas
   l'envoyer. L'ancien fichier en clair est exclu aussi, au cas où il subsisterait.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/spotify_token_encrypted.preferences_pb" />
    <exclude domain="file" path="datastore/spotify_session.preferences_pb" />
    <exclude domain="sharedpref" path="vinylotech_keyset_prefs.xml" />
</full-backup-content>
